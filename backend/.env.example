# .env - Environment variables for YouTube Analyzer
DEBUG=True
SECRET_KEY=django-insecure-youtube-sentiment-college-project-secret-key-2026
DATABASE_URL=postgres://postgres:root@localhost:5432/youtube_analyzer

# YouTube Data API v3 key (enter your key here)
YOUTUBE_API_KEY=

# LLM API Keys (Phase 4)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Celery / Redis (Phase 3)
REDIS_URL=redis://localhost:6379/0
